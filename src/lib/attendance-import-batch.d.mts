export type AttendanceRowStatus = 'pending' | 'ready' | 'ambiguous' | 'unassigned' | 'duplicate' | 'rejected' | 'accepted';
export type AttendanceRowOutcome = 'saved' | 'saved_unassigned' | 'present' | 'verified_present' | 'save_rejected';
export type AttendanceSessionRow = {
  id: number; source_line_hint: number; employee_code: string; site_name: string; happened_at: string; direction: string; source_event_key: string;
  status: AttendanceRowStatus; errors: string[]; warnings: string[]; work_date?: string; candidate_work_dates?: string[]; full_name?: string; outcome?: AttendanceRowOutcome;
};
export type AttendanceSession = { rows: AttendanceSessionRow[]; excluded: Set<number>; workDates: Map<number, string>; uncertain: Set<number> };
export type AttendanceRowView = AttendanceRowStatus | 'saved' | 'uncertain';
export type BatchFailure = { kind: string; error: string };
export type BatchRun = { state: 'complete' | 'failed' | 'stale' | 'paused' | 'offline'; done: number; kind?: string; error?: string };
export type AttendanceSummary = Record<'total' | 'pending' | 'ready' | 'unassigned' | 'ambiguous' | 'duplicate' | 'rejected' | 'saved' | 'savedUnassigned' | 'present' | 'verifiedPresent' | 'uncertain' | 'selected' | 'needsDate', number>;
type ResultRow = { source_line_hint: number; source_event_key: string; status: string; errors?: string[]; warnings?: string[]; work_date?: string; candidate_work_dates?: string[]; full_name?: string };

export const ATTENDANCE_MAX_BYTES: number;
export const ATTENDANCE_MAX_RECORDS: number;
export const ATTENDANCE_BATCH_SIZE: number;
export const ATTENDANCE_PAGE_SIZE: number;
export const attendanceFields: readonly ['employee_code', 'site_name', 'happened_at', 'direction', 'source_event_key'];
export function readAttendanceCsv(buffer: ArrayBuffer | Uint8Array): { error: string } | { headers: string[]; records: { line: number; cells: string[] }[] };
export function suggestAttendanceMapping(headers: string[]): string[];
export function mappingIndexes(mapping: string[], headerCount: number): number[] | null;
export function prepareAttendanceRows(records: { line: number; cells: string[] }[], indexes: number[], headerCount: number): AttendanceSessionRow[];
export function requestRow(row: AttendanceSessionRow): Record<string, string | number>;
export function createImportSession(rows: AttendanceSessionRow[]): AttendanceSession;
export function isSelectable(session: AttendanceSession, row: AttendanceSessionRow): boolean;
export function isSelected(session: AttendanceSession, row: AttendanceSessionRow): boolean;
export function setRowSelected(session: AttendanceSession, id: number, selected: boolean): void;
export function setAllSelected(session: AttendanceSession, selected: boolean): void;
export function chooseWorkDate(session: AttendanceSession, id: number, date: string): void;
export function pendingPreviewIds(session: AttendanceSession): number[];
export function selectedSaveIds(session: AttendanceSession): number[];
export function confirmPayload(session: AttendanceSession, ids: number[]): { row: Record<string, string | number>; workDate?: string }[];
export function applyPreviewBatch(session: AttendanceSession, ids: number[], result: { ok: true; rows: ResultRow[] } | { ok: false; kind: string; error: string } | undefined): BatchFailure | null;
export function applyConfirmBatch(session: AttendanceSession, ids: number[], result: { state: string; rows: ResultRow[]; error: string; errorKind?: string } | undefined): BatchFailure | null;
export function runBatches<T>(options: { ids: number[]; size?: number; send: (batch: number[]) => Promise<T>; apply: (batch: number[], result: T | undefined) => BatchFailure | null;
  shouldStop: () => 'paused' | 'offline' | null; isCurrent: () => boolean; onProgress: (done: number) => void }): Promise<BatchRun>;
export function rowView(session: AttendanceSession, row: AttendanceSessionRow): AttendanceRowView;
export function summarizeSession(session: AttendanceSession): AttendanceSummary;
export function filterRowIds(session: AttendanceSession, filter: AttendanceRowView | 'all'): number[];
export function pageOf(ids: number[], page: number, size?: number): { page: number; pages: number; ids: number[] };
export function rejectedRowsCsv(rows: AttendanceSessionRow[]): string;
