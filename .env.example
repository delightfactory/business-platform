# Local Supabase CLI defaults. Fill in the publishable key from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase secret key for sending Auth invitations. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
